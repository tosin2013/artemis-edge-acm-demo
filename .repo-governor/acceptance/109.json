{
  "authority_id": "109",
  "$comment": "workshop-demo-reader RBAC for all demo modules — policies, AMQ CRDs, routes, etc.",
  "criteria": [
    {
      "check": "file_exists",
      "target": "templates/workshop-user-rbac.yaml",
      "$comment": "RBAC template exists"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'workshop-demo-reader' templates/workshop-user-rbac.yaml",
      "$comment": "workshop-demo-reader ClusterRole defined"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'workshop-users-demo-reader' templates/workshop-user-rbac.yaml",
      "$comment": "workshop-users-demo-reader ClusterRoleBinding defined"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'policy.open-cluster-management.io' templates/workshop-user-rbac.yaml",
      "$comment": "policy API group in ClusterRole rules"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'broker.amq.io' templates/workshop-user-rbac.yaml",
      "$comment": "broker.amq.io API group in ClusterRole rules"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'route.openshift.io' templates/workshop-user-rbac.yaml",
      "$comment": "route.openshift.io API group in ClusterRole rules"
    },
    {
      "check": "command_exit",
      "target": "helm template . --values values.yaml --show-only templates/workshop-user-rbac.yaml 2>/dev/null | grep -q 'workshop-demo-reader'",
      "$comment": "Helm template renders without error"
    }
  ]
}
