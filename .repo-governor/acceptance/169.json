      "target": "grep -q 'argoproj.io_ApplicationSet' scripts/patch-argocd-health-check.sh && grep -q 'applicationSet' scripts/patch-argocd-health-check.sh"
    },
    {
      "check": "file_exists",
      "target": "templates/acm-placement-configmap.yaml"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'sync-wave' templates/global-hub-argocd-bridge.yaml"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'patch-argocd-health-check' scripts/post-provision-multihub.sh || grep -q 'patch-argocd-health-check' scripts/deploy.sh"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'ApplicationSet' docs/developer-guide.md && grep -q 'acm-placement' docs/developer-guide.md"
    }
  ]
