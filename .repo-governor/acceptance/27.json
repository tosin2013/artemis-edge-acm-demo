    {
      "check": "command_exit",
      "target": "! grep -q 'openshift-cluster_' scripts/save-deployment-info.sh"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'ocp_version' onboard.yml"
    },
    {
      "check": "command_exit",
      "target": "grep -q 'ArgoCD\\|openshift-gitops' onboard.yml"
    },
    {
