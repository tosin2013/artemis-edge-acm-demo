---
# ===================================================================
# Artemis Edge ACM Demo — GCP Secrets Template
# ===================================================================
#
# Copy this file and fill in values:
#   cp secrets.yml.example ~/Development/agnosticd-v2-secrets/secrets-<account>.yml
#
# NEVER commit the filled-in version to Git.
# ===================================================================

# GCP Open Environment details
base_domain: "<sandbox-id>.gcp.redhatworkshops.io"
gcp_project_id: "<gcp-project-id>"
gcp_region: "us-east1"
gcp_service_account: "sa-<sandbox-id>@rhpds-345620.iam.gserviceaccount.com"

# Path to GCP service account JSON key file
# Download from GCP Console > IAM > Service Accounts > Keys
gcp_credentials_file: "~/Development/agnosticd-v2-secrets/gcp-key-<sandbox-id>.json"

# RHDP Open Environment platform variables
# Discover from existing project:
#   gcloud projects describe <project-id> --format='json(parent,labels)'
#   gcloud billing projects describe <project-id> --format='json(billingAccountName)'
agnosticd_open_environment: true
requester_email: "<your-email>@redhat.com"
gcp_open_env_folder_id: "<folder-id>"
gcp_cost_center: "<cost-center>"
gcp_billing_account_id: "<billing-account-id>"
gcp_admin_group: "group:rhdp-gcp-admins@redhat.com"
project_name: "<gcp-project-id>"

# OpenShift pull secret (get from https://console.redhat.com/openshift/install/pull-secret)
ocp4_pull_secret: >-
  {"auths":{"cloud.openshift.com":{"auth":"..."}}}

# Note: GCP RHEL cloud images have repos pre-configured via RHUI.
# Satellite settings are not needed for GCP deployments.

# ===================================================================
# First-time deployment notes
# ===================================================================
#
# 1. Run ./bootstrap.sh to validate prerequisites and scaffold secrets
# 2. Run ./scripts/deploy.sh --guid <GUID> --account <ACCOUNT>
#
# If deploying to an existing RHDP Open Environment (project already
# created), set gcp_create_open_env_project: false in vars.yml.
# This requires a local patch to AgnosticD's pre_infra.yml — see:
# https://github.com/tosin2013/artemis-edge-acm-demo/issues/25
#
# Key vars.yml settings for GCP Open Environments:
#   software_to_deploy: openshift4       # required — without this OCP is not installed
#   ocp4_base_domain: "{{ base_domain }}" # must match existing DNS zone
#   repo_method: none                     # GCP uses RHUI, not Satellite
#   gcp_create_open_env_project: false    # skip project creation for existing envs
